{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug, warnings as errors",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DIFFCORE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "Debug with AddressSanitizer and UBSan (GCC/Clang)",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DIFFCORE_SANITIZE": "ON",
        "DIFFCORE_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "mingw",
      "displayName": "Windows x64 with MinGW-w64, tests under Wine (Linux host)",
      "binaryDir": "${sourceDir}/build/mingw",
      "toolchainFile": "${sourceDir}/cmake/mingw-w64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DIFFCORE_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_CROSSCOMPILING_EMULATOR": "wine64"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "mingw32",
      "displayName": "Windows x86 (32-bit) with MinGW-w64, build only (Linux host)",
      "binaryDir": "${sourceDir}/build/mingw32",
      "toolchainFile": "${sourceDir}/cmake/mingw-w64-i686.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DIFFCORE_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    {
      "name": "asan",
      "configurePreset": "asan",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "mingw",
      "configurePreset": "mingw",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "mingw32",
      "configurePreset": "mingw32",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "mingw",
      "configurePreset": "mingw",
      "output": { "outputOnFailure": true },
      "environment": { "WINEDEBUG": "-all", "PATH": "/usr/lib/wine:$penv{PATH}" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ]
}
